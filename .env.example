# Copy this file to `.env` and fill in your values, then restart `npm run dev`.

# Google OAuth Client ID (Google Cloud Console → Credentials → OAuth client → Web).
# Add your dev origin (e.g. http://localhost:5173) to Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=

# Where submitted stories are saved (POST as JSON). Leave blank to store locally.
# e.g. a Supabase Edge Function, or a Google Apps Script web-app URL that appends to a Sheet.
VITE_SUBMISSIONS_ENDPOINT=


# BytePlus ARK (Dreamina-Seedance) — used by scripts/gen-videos.mjs to generate pillar loops.
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Model IDs
SEEDANCE_MODEL=dreamina-seedance-2-5-260628
SEEDANCE_I2V_MODEL=dreamina-seedance-2-5-260628
SEEDANCE_25_MODEL=dreamina-seedance-2-5-260628
SEEDREAM_MODEL=seedream-4-0-250828

# BytePlus Open API (Asset Library) — Volcengine AK/SK
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
